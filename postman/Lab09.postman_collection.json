    {
      "name": "Task 4 - SortOrderPipe",
      "item": [
        {
          "name": "Default ascending order - GET notes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notes",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Default order returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Titles are ascending', () => { const a=pm.response.json().map(n=>n.title); pm.expect(a).to.eql([...a].sort((x,y)=>x.localeCompare(y,undefined,{sensitivity:'base'}))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Descending order - GET notes order DESC",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notes?order=DESC",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DESC is accepted', () => pm.response.to.have.status(200));",
                  "pm.test('Titles are descending', () => { const a=pm.response.json().map(n=>n.title); const expected=[...a].sort((x,y)=>y.localeCompare(x,undefined,{sensitivity:'base'})); pm.expect(a).to.eql(expected); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid sort order - GET notes order random",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notes?order=random",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
