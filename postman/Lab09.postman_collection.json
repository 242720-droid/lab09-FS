  "item": [
    {
      "name": "Task 1 - Secure bootstrap",
      "item": [
        {
          "name": "Security headers - GET health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Helmet nosniff header exists', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('Content security policy header exists', () => pm.expect(pm.response.headers.has('Content-Security-Policy')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unknown isAdmin property - POST register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Validation Test\",\n  \"email\": \"validation-check@example.com\",\n  \"password\": \"Secure1234\",\n  \"isAdmin\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Unknown property is rejected', () => pm.expect(pm.response.text()).to.include('isAdmin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS preflight from allowed origin",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Allowed CORS origin is returned', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173'));"
                ]
              }
            }
          ]
        }
